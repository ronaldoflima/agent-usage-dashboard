#!/usr/bin/env python3
# pacebar: Claude weekly limit pace (actual usage ÷ expected usage so far) on one line (ccstatusline custom-command widget).
#
# Reads the statusline JSON from stdin (rate_limits.seven_day). The expected curve comes from the
# agent-usage-dashboard historical profile (CLAUDE_USAGE_URL, default http://127.0.0.1:8787);
# without the dashboard it uses a linear curve and prefixes the value with "~". Same thresholds as the dashboard:
# Labels follow the dashboard language (en, pt-BR, es), defaulting to English.
# > 1.08x fast (▲), < 0.82x slow (▽), in between on pace (=).
import json
import os
import sys
import time

WEEK_H = 168
MIN_PROFILE_HOURS = 168
CACHE_TTL = 3600
OUT_TTL = 60
BASE_URL = os.environ.get("CLAUDE_USAGE_URL", "http://127.0.0.1:8787").rstrip("/")
URL = BASE_URL + "/api/profile"
LABELS = {"en": ("pace", "expected"), "pt-BR": ("ritmo", "ideal"), "es": ("ritmo", "ideal")}
TMP = os.environ.get("TMPDIR") or "/tmp"
CACHE = os.path.join(TMP, f"pacebar.{os.getuid()}.profile.json")
OUT_CACHE = os.path.join(TMP, f"pacebar.{os.getuid()}.out.json")


def write_atomic(path, obj):
    tmp = f"{path}.{os.getpid()}"
    try:
        with open(tmp, "w") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def load_profile():
    stale = None
    try:
        with open(CACHE) as fh:
            stale = json.load(fh) or None
        if time.time() - os.path.getmtime(CACHE) < CACHE_TTL:
            return stale
    except (OSError, ValueError):
        pass
    import urllib.request
    profile = None
    try:
        with urllib.request.urlopen(URL, timeout=1) as resp:
            data = json.load(resp)
        if data.get("ok") and len(data.get("weekly", {}).get("slots") or []) == WEEK_H:
            profile = data
    except Exception:
        pass
    profile = profile or stale
    write_atomic(CACHE, profile)
    return profile


def aligned_slots(profile, start):
    weekly = profile["weekly"]
    hours = profile.get("sample_hours")
    reliability = max(0.0, min(1.0, hours / MIN_PROFILE_HOURS)) if isinstance(hours, (int, float)) else 1.0
    slots = [reliability * v + (1 - reliability) / WEEK_H for v in weekly["slots"]]
    from zoneinfo import ZoneInfo
    local = start.astimezone(ZoneInfo(weekly["timezone"]))
    offset = (local.weekday() * 24 + local.hour + local.minute / 60 + local.second / 3600
              - weekly["reset_weekday"] * 24 - weekly["reset_hour"] + WEEK_H) % WEEK_H
    whole, frac = int(offset), offset - int(offset)
    return [slots[(i + whole) % WEEK_H] * (1 - frac) + slots[(i + whole + 1) % WEEK_H] * frac for i in range(WEEK_H)]


def expected_pct(slots, elapsed_h):
    pos = max(0.0, min(float(WEEK_H), elapsed_h))
    whole, frac = int(pos), pos - int(pos)
    done = sum(slots[:whole]) + (slots[whole] * frac if whole < WEEK_H else 0)
    return min(100.0, done * 100)


def dashboard_limits():
    import urllib.request
    try:
        with urllib.request.urlopen(BASE_URL + "/api/limits", timeout=3) as resp:
            limits = json.load(resp).get("limits") or []
        weekly = next(x for x in limits if x.get("kind") == "weekly_all")
        resets = datetime.fromisoformat(weekly["resets_at"]).timestamp()
        return {"rate_limits": {"seven_day": {"used_percentage": weekly["utilization"], "resets_at": resets}}}
    except Exception:
        return {}


def main():
    if sys.stdin.isatty():
        data = dashboard_limits()
    else:
        try:
            data = json.load(sys.stdin)
        except ValueError:
            return
    period = ((data.get("rate_limits") or {}).get("seven_day")) or {}
    used, resets = period.get("used_percentage"), period.get("resets_at")
    if used is None or not resets:
        return
    now = time.time()
    start = float(resets) - WEEK_H * 3600
    if not start <= now < float(resets):
        return
    key = [float(used), float(resets)]
    try:
        with open(OUT_CACHE) as fh:
            cached = json.load(fh)
        if cached.get("key") == key and now - cached.get("at", 0) < OUT_TTL:
            print(cached["out"])
            return
    except (OSError, ValueError, AttributeError):
        pass
    from datetime import datetime, timezone
    elapsed_h = max(1 / 60, (now - start) / 3600)
    profile = load_profile()
    pace_label, expected_label = LABELS.get((profile or {}).get("language"), LABELS["en"])
    if profile:
        expected = expected_pct(aligned_slots(profile, datetime.fromtimestamp(start, timezone.utc)), elapsed_h)
        mark = ""
    else:
        expected = min(100.0, elapsed_h / WEEK_H * 100)
        mark = "~"
    used = float(used)
    ratio = used / expected if expected > 0 else 0.0
    if used >= 100:
        arrow = "■"
    elif ratio > 1.08:
        arrow = "▲"
    elif ratio < 0.82:
        arrow = "▽"
    else:
        arrow = "="
    out = f"{pace_label} {mark}{ratio:.2f}x {arrow} ({expected_label} {expected:.0f}%)"
    write_atomic(OUT_CACHE, {"key": key, "at": now, "out": out})
    print(out)


if __name__ == "__main__":
    main()
